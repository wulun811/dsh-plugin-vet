{
  "name": "@jieai/dsh-plugin-vet",
  "version": "0.1.0",
  "description": "Plugin trust pipeline for deepseek-harness: deterministic static scan + LLM audit + two-score scorecard.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AUDIT_PROTOCOL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:scanner && npm run build:src && npm run build:client",
    "build:scanner": "tsc -p tsconfig.scanner.json",
    "build:src": "tsc -p tsconfig.src.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "npm run typecheck:scanner && npm run typecheck:src && npm run typecheck:client",
    "typecheck:scanner": "tsc -p tsconfig.scanner.json --noEmit",
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "react": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
